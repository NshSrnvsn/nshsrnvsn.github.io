---
import { getCollection, type CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import EdgeCrab from "@/layouts/EdgeCrab.astro";
import Crab from "@/assets/images/crab.png";
import PostList from "@/layouts/PostList.astro";

const posts: CollectionEntry<"blog">[] = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts<"blog">(posts);
---

<Layout title={`Blog | ${SITE.title}`}>
  <Header />
  <EdgeCrab spriteUrl={Crab} />
  <Main pageTitle="Blog" pageDesc="Articles I've written">
    <PostList posts={sortedPosts} />

    <div class="substack-callout">
    <h3>📬 Read my latest writing on [<a
      href="https://substack.com/@nshsrnvsn/posts"
      target="_blank"
      rel="noopener noreferrer"
      class="underline"
    >Substack</a>]</h3>

  </div>
  </Main>
  <Footer />
</Layout>
