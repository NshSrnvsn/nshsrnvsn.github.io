---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import EdgeCrab from "@/layouts/EdgeCrab.astro";
import Crab from "@/assets/images/crab.png";
import { SOCIALS } from "@/constants";
---

<Layout>
  <Header />
  <EdgeCrab spriteUrl={Crab} />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-12 pb-6"]}>
      <!---<h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Anusha Srinivasan
      </h1>--->
      <p> Helloo! I'm glad you found your way here.
      </p>
      <br />
      <p>
      If you’re here for the serious stuff, check out [<a href="/AnushaSrinivasan_Resume.pdf" class="underline">my work</a>].
      If you're here because you're curious, wander through [<a href="/archives" class="underline">the things I do</a>] and [<a href="/blog" class="underline">the things I write about</a>].
      </p>
      <br />
      <p>
      I spend a good chunk of my time building software, teaching computers to think and finishing my master's at Georgia Tech. 
      </p>
      <br />
      <p>
      The rest of my time is a little harder to summarize.
      </p>
      <br />
      <p>
      I paint. I travel. I write about whatever catches my attention. I'm currently attempting to build a skateboard (results pending). I play surprisingly good Kho-Kho for a non-athletic person.
      </p> 
      <br/>
      <p>
        Stay for a while. ♥
      </p>

      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-20 mb-4 flex flex-col items-center justify-center text-center">
            <Socials />
          </div>
        )
      }
    </section>

    <!---{
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }--->

    <!---{
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }--->
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
