---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
	posts: CollectionEntry<"blog">[];
	/** Seeds the `--i` stagger-animation index (e.g. when rows follow a featured post). */
	startIndex?: number;
	/** Heading tag for each post title. */
	headingLevel?: "h2" | "h3";
}

const { posts, startIndex = 0, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;

const formatRailDate = (value: Date) =>
	new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(value);
---

<ol class="timeline" aria-label="Blog posts">
	{
		posts.map((p, idx) => {
			const postDate = p.data.modDatetime ?? p.data.pubDatetime;

			return (
				<li class="post-row" style={`--i: ${startIndex + idx}`}>
					<a class="post" data-astro-prefetch href={getPath(p.id, p.filePath, true, "blog")}>
						<div class="post-rail">
							<time class="post-date" datetime={postDate.toISOString()}>
								{formatRailDate(postDate)}
							</time>
							<span class="post-dot" aria-hidden="true" />
						</div>
						<div class="post-body">
							<Heading class="post-title">{p.data.title}</Heading>
							<p class="post-preview">{p.data.description}</p>
						</div>
					</a>
				</li>
			);
		})
	}
</ol>
